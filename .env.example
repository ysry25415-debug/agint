# Product Hunter AI - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
APP_NAME=Product Hunter AI
APP_VERSION=0.1.0

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=product_hunter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional, leave empty if not used

# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here

# ============================================
# AI Provider Configuration
# ============================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Exchange Rates API
# ============================================
EXCHANGE_RATES_API_KEY=your_exchange_rates_api_key_here

# ============================================
# Marketplace API Keys
# ============================================
# Alibaba API Key
ALIBABA_API_KEY=your_alibaba_api_key_here

# AliExpress API Key
ALIEXPRESS_API_KEY=your_aliexpress_api_key_here

# Amazon Egypt Access Key
AMAZON_EG_ACCESS_KEY=your_amazon_eg_key_here

# Jumia API Key
JUMIA_API_KEY=your_jumia_api_key_here

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO